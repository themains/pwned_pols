figure.facecolor: white
axes.facecolor: white
axes.edgecolor: 0.15
axes.labelcolor: 0.15
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True
axes.grid: False
axes.titlesize: 10.5
axes.labelsize: 10
xtick.color: 0.15
ytick.color: 0.15
xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: out
ytick.direction: out
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.8
ytick.major.width: 0.8
font.family: sans-serif
font.size: 10
legend.frameon: False
legend.fontsize: 9
lines.linewidth: 1.2
patch.edgecolor: 0.35
savefig.facecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.02
